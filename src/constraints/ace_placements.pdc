# -------------------------------------------------------------------------
# ACE placements file
# This defines the physical placement of instances on the die
# IO locations are defined within the IO ring PDC, however instance locations
# and placement regions can be defined here

# -------------------------------------------------------------------------
# Place NAPs
# For consistency between simulation and implmentation the NAP locations
# match those in the top level testbench
# -------------------------------------------------------------------------
#Quadrant 0: SW
# ACE aborts run_prepare when a set_placement names an object that is not in
# the design.  This file enumerates all four TC quads and the FP matrix path,
# so any build with NUM_TC_QUAD < 4, or with MLP_16BIT = 0 where
# i_matrix_mult_fp does not exist, leaves placements pointing at nothing.  ACE
# then reports "Incompatible <objName> and <siteName> list sizes" for the
# find -insts form, or a missing instance for the others, and the whole flow
# stops.  Route every placement through a guard that skips silently when the
# instance is absent.
proc pi0_place {inst site {batch 0}} {
    if {[catch {find -insts $inst} objs]} {
        return
    }
    if {[llength $objs] == 0} {
        return
    }
    if {$batch} {
        set_placement -fixed -batch $objs $site
    } else {
        set_placement -fixed $objs $site
    }
}

# The NAP floorplan below depends on how many quads the build instantiates,
# because the shipped coordinates are a four-quadrant pinwheel and a build with
# fewer quads inherits only a corner of it.
#
# At NUM_TC_QUAD=1 that is harmless: quad 0 sits in the SW quadrant and the
# design uses 39% of the device LUT.
#
# At NUM_TC_QUAD=2 it is not.  Quad 1's shipped coordinates are the NW
# quadrant, so both quads' 64 NAPs land in the LEFT HALF of the 10x8 NoC grid
# while two quads of logic is about 75% of the device LUT and must spread over
# all of it.  Every tensor core would be pulled toward a NAP in one half of the
# die.  The measured 16-TC build already places at only 6.4 LUT per occupied
# RLB tile (42,223 tiles holding 271,462 LUT, 73.30% tile occupancy at 39.27%
# LUT), so at two quads the placer has to roughly double its packing density
# even with a good floorplan.  It does not need a bad one as well.
#
# At two quads the split is therefore by column, not by row: quad 0 takes the
# left columns on odd rows, quad 1 the right columns on even rows.  Each quad
# spans the full height of the die, its 16 cores have NAPs distributed through
# their own half, and the two quads cannot contend for a site because their
# column sets and their row sets are both disjoint.
#
# Columns 3 and 8 are reserved in every case for the three top-level NAPs
# placed further down, which is why no quad ever uses them.
#
# The generator reproduces the previous 128 literal placements exactly for the
# one-quad and four-quad cases; only the two-quad case is new.  Grid extent is
# 10 columns x 8 rows = 80 sites, which matches "NAP_MASTER Total 18 80" in
# pnr/reports/tc_ref_design_top_utilization_final.txt.
proc pi0_place_quad_naps {quad cols rows} {
    for {set ring 0} {$ring < 16} {incr ring} {
        set col [lindex $cols [expr {$ring % 4}]]
        set row [lindex $rows [expr {$ring / 4}]]
        pi0_place \
            "tc_gen_quad_${quad}__i_tc_quad.tc_gen_noc_${ring}__i_axi_slave_wrapper.i_axi_slave" \
            "s:x_core.NOC\[$col\]\[$row\].logic.noc.nap_s"
        pi0_place \
            "tc_gen_quad_${quad}__i_tc_quad.tc_gen_noc_${ring}__nap_reg_control_block.i_axi_master.i_axi_master" \
            "s:x_core.NOC\[$col\]\[$row\].logic.noc.nap_m"
    }
}

proc pi0_quad_present {quad} {
    if {[catch {find -insts "tc_gen_quad_${quad}__i_tc_quad.tc_gen_noc_0__i_axi_slave_wrapper.i_axi_slave"} objs]} {
        return 0
    }
    return [expr {[llength $objs] > 0}]
}

if {[pi0_quad_present 1] && ![pi0_quad_present 2]} {
    puts "INFO: pi0 NAP floorplan: two quads, split left/right over the full die height"
    pi0_place_quad_naps 0 {1 2 4 5}  {1 3 5 7}
    pi0_place_quad_naps 1 {10 9 7 6} {8 6 4 2}
} else {
    puts "INFO: pi0 NAP floorplan: original four-quadrant pinwheel"
    pi0_place_quad_naps 0 {1 2 4 5}  {1 2 3 4}
    pi0_place_quad_naps 1 {1 2 4 5}  {8 7 6 5}
}
pi0_place_quad_naps 2 {10 9 7 6} {8 7 6 5}
pi0_place_quad_naps 3 {10 9 7 6} {1 2 3 4}

